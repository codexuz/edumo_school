        {
          "type": "ex",
          "id": "A1_U01_WB_GR_01",
          "kind": "gap",
          "instruction": "Complete with 'm, 's or 're.",
          "example": "I**'m** from Fergana.",
          "items": [
            {"q": "She______ a nurse.", "a": "'s"},
            {"q": "We______ in the evening class.", "a": "'re"},
            {"q": "It______ a beautiful city.", "a": "'s"},
            {"q": "I______ 21 years old.", "a": "'m"},
            {"q": "They______ from Turkey.", "a": "'re"},
            {"q": "He______ my teacher.", "a": "'s"}
          ]
        },
        {
          "type": "ex",
          "id": "A1_U01_WB_GR_02",
          "kind": "gap",
          "instruction": "Complete with am, is, are, isn't or aren't.",
          "items": [
            {"q": "Ms Lee ______ from China. She's from South Korea.", "a": "isn't"},
            {"q": "My brothers ______ students. They're doctors.", "a": "aren't"},
            {"q": "I ______ 17. My birthday is today!", "a": "am"},
            {"q": "\"______ your teacher British?\" \"Yes, she is.\"", "a": "Is"},
            {"q": "\"______ you from Khiva?\" \"No, I'm from Urgench.\"", "a": "Are"},
            {"q": "Bukhara ______ a new city. It's very old.", "a": "isn't"},
            {"q": "My friends and I ______ in the same class.", "a": "are"},
            {"q": "Your phone number ______ on the form. Please write it.", "a": "isn't"}
          ]
        },
        {
          "type": "ex",
          "id": "A1_U01_WB_GR_03",
          "kind": "short",
          "instruction": "Write questions and short answers.",
          "example": "you / Uzbek? (✓) → **Are you Uzbek? Yes, I am.**",
          "items": [
            {"q": "she / a student? (✗)", "a": "Is she a student? No, she isn't."},
            {"q": "they / from Samarkand? (✓)", "a": "Are they from Samarkand? Yes, they are."},
            {"q": "he / married? (✗)", "a": "Is he married? No, he isn't."},
            {"q": "you / 18? (✓)", "a": "Are you 18? Yes, I am."},
            {"q": "it / a big city? (✓)", "a": "Is it a big city? Yes, it is."}
          ]
        },
        {
          "type": "ex",
          "id": "A1_U01_WB_GR_04",
          "kind": "correct",
          "instruction": "Find and correct the mistake in each sentence.",
          "items": [
            {"q": "My mother teacher.", "a": "My mother is a teacher."},
            {"q": "We is from Kazakhstan.", "a": "We are from Kazakhstan."},
            {"q": "I'm not student.", "a": "I'm not a student."},
            {"q": "\"Is he Russian?\" \"Yes, he's.\"", "a": "Yes, he is."},
            {"q": "She is a engineer.", "a": "She is an engineer."},
            {"q": "Where you are from?", "a": "Where are you from?"}
          ]
        },
        {
          "type": "ex",
          "id": "A1_U01_WB_GR_05",
          "kind": "short",
          "instruction": "Translate into English.",
          "note": "“U” = he or she.",
          "items": [
            {"q": "Men talabaman.", "a": "I am a student. / I'm a student."},
            {"q": "U o‘qituvchi emas.", "a": "He / She isn't a teacher."},
            {"q": "Siz qayerdansiz?", "a": "Where are you from?"},
            {"q": "Biz Samarqanddanmiz.", "a": "We are from Samarkand. / We're from Samarkand."},
            {"q": "Ular turmush qurganmi?", "a": "Are they married?"}
          ]
        }
